{% extends "base.html.j2" %}
{% set current_date = ed.date if ed else None %}
{% block title %}{{ site.title }}{% if ed and not latest %} · {{ ed.date | long_date }}{% endif %}{% endblock %}
{% block subtitle %}{% if ed and not latest %}{{ ed.date | short_day }}{% else %}Today{% endif %}{% endblock %}
{% block main %}
{% if not ed %}
  <section class="empty"><div class="wrap">
    <h2>No edition yet</h2>
    <p>The first edition appears here after the next morning run.</p>
  </div></section>
{% else %}
  {% set stories = ed.stories %}
  <section class="hero"><div class="wrap">
    <div class="eyebrow">{{ site.greeting if latest else 'Earlier edition' }}</div>
    <h1>{{ ed.date | long_date }}</h1>
    {% if ed.headline %}<p class="lead">{{ ed.headline }}</p>{% endif %}
    <div class="stats">
      {% for t in topics %}
      <a class="stat" href="#{{ t.key }}"><b>{{ stories | selectattr('topic', 'equalto', t.key) | rejectattr('extra') | list | length }}</b>{{ t.name }}</a>
      {% endfor %}
    </div>
  </div></section>

  {% for t in topics %}
  {% set list = stories | selectattr('topic', 'equalto', t.key) | list %}
  {% set more = list | selectattr('extra') | list %}
  <section class="tile {{ t.tone }} {{ t.key }}" id="{{ t.key }}"><div class="wrap">
    <div class="tile-head">
      {% if t.jp %}<div class="jp" lang="ja">{{ t.jp }}</div>{% endif %}
      <h2>{{ t.name }}</h2>
      <p>{{ t.tagline }}</p>
      {% set main_n = list | length - more | length %}
      <div class="count">{% if list %}{{ main_n }} {{ 'story' if main_n == 1 else 'stories' }}{% if more %} · {{ more | length }} more in reserve{% endif %}{% else %}Quiet morning. Nothing new here.{% endif %}</div>
    </div>
    <div class="grid">
      {% for s in list %}
      {% set when = age(s.date, ed.date) %}
      <article class="card{% if loop.first %} lead{% endif %}{% if s.image %} has-img{% endif %}{% if s.extra %} extra{% endif %}"{% if s.extra %} hidden{% endif %} data-id="{{ s.id }}" data-topic="{{ s.topic }}" data-source="{{ s.source }}" data-title="{{ s.title }}">
        {% if s.image %}
        <a class="media" href="{{ s.url }}" target="_blank" rel="noopener" tabindex="-1" aria-hidden="true">
          <img src="{{ s.image }}" alt="" loading="{{ 'eager' if loop.first else 'lazy' }}" decoding="async">
          {% if s.kind == 'video' %}<span class="play"><svg width="20" height="20"><use href="#i-play"/></svg></span>{% endif %}
        </a>
        {% endif %}
        <div class="body">
          <div class="meta">
            <span class="src">{{ s.source }}</span><span>{{ when }}</span>
            {% if s.kind == 'video' %}<span class="kind">Video</span>{% elif s.kind == 'reddit' %}<span class="kind">Discussion</span>{% endif %}
            {% if when in ('Today', 'Yesterday') %}<span class="badge">New</span>{% endif %}
          </div>
          <h3><a href="{{ s.url }}" target="_blank" rel="noopener">{{ s.title }}</a></h3>
          {% if s.title_ja %}<div class="jp-title" lang="ja">{{ s.title_ja }}</div>{% endif %}
          {% if s.summary %}<p class="sum">{{ s.summary }}</p>{% endif %}
          <div class="foot">
            <div class="links">
              <a href="{{ s.url }}" target="_blank" rel="noopener">{{ 'Watch' if s.kind == 'video' else 'Read' }} on {{ s.source }} ›</a>
              {% for a in s.also or [] %}<a class="also" href="{{ a.url }}" target="_blank" rel="noopener">Also on {{ a.source }}</a>{% endfor %}
            </div>
            <div class="votes">
              <button class="vote up" type="button" aria-pressed="false" aria-label="More like this" title="More like this"><svg aria-hidden="true"><use href="#i-up"/></svg></button>
              <button class="vote down" type="button" aria-pressed="false" aria-label="Less like this" title="Less like this"><svg aria-hidden="true"><use href="#i-down"/></svg></button>
              <button class="vote save" type="button" aria-pressed="false" aria-label="Save for later" title="Save for later"><svg class="ic-off" aria-hidden="true"><use href="#i-save"/></svg><svg class="ic-on" aria-hidden="true"><use href="#i-saved"/></svg></button>
            </div>
          </div>
        </div>
      </article>
      {% endfor %}
    </div>
    {% if more %}
    <div class="more-row"><button class="pill more" type="button" aria-expanded="false">Show {{ more | length }} more {{ 'story' if more | length == 1 else 'stories' }}</button></div>
    {% endif %}
    <p class="allread">You're all caught up here.</p>
  </div></section>
  {% endfor %}

  {% if older or newer %}
  <nav class="pager" aria-label="Other editions"><div class="wrap">
    {% if older %}<a class="pill" href="{{ older }}.html">‹ {{ older | long_date }}</a>{% else %}<span></span>{% endif %}
    {% if newer %}<a class="pill" href="{{ newer }}.html">{{ newer | long_date }} ›</a>{% endif %}
  </div></nav>
  {% endif %}
{% endif %}
{% if ed %}
<script type="application/json" id="pline-stories">{{ ed.stories | map('pick_story') | list | tojson }}</script>
{% endif %}
{% endblock %}
{% block footer %}
  {% if ed %}<p>Edition compiled {{ ed.generated_at[:16] | replace('T', ' at ') }} ({{ site.timezone }}) from {{ ed.sources_ok }} of {{ ed.sources_total }} sources{% if ed.writer %}, summaries written by {{ ed.writer }}{% endif %}{% if ed.taste and (ed.taste.likes or ed.taste.dislikes) %}, tuned by {{ ed.taste.likes }} likes and {{ ed.taste.dislikes }} “less like this”{% endif %}. Summaries are paraphrased; tap a headline for the original. Pictures are thumbnails of each article's own preview image.</p>{% endif %}
{% endblock %}
